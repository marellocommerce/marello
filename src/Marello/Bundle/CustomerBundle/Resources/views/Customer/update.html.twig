{% extends '@OroUI/actions/update.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}
{% form_theme form with '@OroForm/Form/fields.html.twig' %}

{% set entity = form.vars.value %}
{% if entity.id %}
    {% oro_title_set({params : {"%name%": entity.fullName } }) %}
{% endif %}

{% set formAction = entity.id ? path('marello_customer_update', { id: entity.id }) : path('marello_customer_create') %}

{% block navButtons %}
    {{ UI.cancelButton(path('marello_customer_index')) }}
    {% set html = UI.saveAndCloseButton({
        'route': 'marello_customer_view',
        'params': {'id': '$id'}
    }) %}
    {% if is_granted('marello_customer_update') %}
        {% set html = html ~ UI.saveAndStayButton({
            'route': 'marello_customer_update',
            'params': {'id': '$id'}
        }) %}
    {% endif %}
    {{ UI.dropdownSaveButton({ 'html': html }) }}
{% endblock navButtons %}

{% block pageHeader %}
    {% if entity.id %}
        {% set breadcrumbs = {
            'entity':      entity,
            'indexPath':   path('marello_customer_index'),
            'indexLabel': 'marello.customer.entity_plural_label'|trans,
            'entityTitle': entity.fullName|default('N/A')
        } %}
        {{ parent() }}
    {% else %}
        {% set title = 'oro.ui.create_entity'|trans({'%entityName%': 'marello.customer.entity_label'|trans}) %}
        {% include '@OroUI/page_title_block.html.twig' with { title: title } %}
    {% endif %}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'marello-customer-update' %}

    {% set dataBlocks = [{
        'title': 'General'|trans,
        'class': 'active',
        'subblocks': [{
            'title': '',
            'data': [
                form_row(form.company),
                form_row(form.namePrefix),
                form_row(form.firstName),
                form_row(form.middleName),
                form_row(form.lastName),
                form_row(form.nameSuffix),
                form_row(form.email),
                form_row(form.customerNumber),
                form_row(form.customerGroup),
                form_row(form.localization),
                form_row(form.enabled)
            ]
        }]
    }] %}

    {% set primaryAddress %}
        <div
            data-page-component-module="oroui/js/app/components/view-component"
            data-page-component-options="{{ {
                view: 'marellocustomer/js/app/views/customer-primary-address-view',
                selectors: {
                    usePrimaryAsShipping: '#' ~ form.primaryAddress.usePrimaryAddressAsShipping.vars.id,
                    shippingAddressBlock: '#' ~ form.shippingAddress.vars.id
                }
            }|json_encode }}">
            {{ form_widget(form.primaryAddress) }}
        </div>
    {% endset %}

    {% set shippingAddress %}
        <div id="{{ form.shippingAddress.vars.id }}">
            {{ form_widget(form.shippingAddress) }}
        </div>
    {% endset %}

    {% set frontendFormOptions = [
        form_widget(form.plainPassword, { 'attr': {'class': 'password control-group-container'} })
    ] %}

    {% if form.passwordGenerate is defined %}
        {% set frontendFormOptions = frontendFormOptions|merge([
            form_row(form.passwordGenerate, { 'attr': {'class': 'password-trigger'} })
        ]) %}
        <span data-page-component-module="orouser/js/components/password-generate"
              data-page-component-options="{{ {checkbox: '[data-name="field__password-generate"]', passwordInput: '[data-name="field__first"],[data-name="field__second"]'}|json_encode }}"></span>
    {% endif %}

    {% if form.sendEmail is defined %}
        {% set frontendFormOptions = frontendFormOptions|merge([
            form_row(form.sendEmail)
        ]) %}
    {% endif %}

    {% set dataBlocks = dataBlocks|merge( [{
        'title' : 'Customer Frontend',
        'subblocks': [{
            'title': '',
            'data': frontendFormOptions
        }]
    }] ) %}

    {% set dataBlocks = dataBlocks|merge( [{
        'title' : 'marello.customer.addresses.label'|trans,
        'subblocks': [{
            'title': 'marello.customer.primary_address.label'|trans,
            'data': [primaryAddress]
        },
        {
            'title': 'marello.customer.shipping_address.label'|trans,
            'data': [shippingAddress]
        }]
    }] ) %}

    {% set additionalData = [] %}
    {% for child in form.children %}
        {% if child.vars.extra_field is defined and child.vars.extra_field %}
            {% set additionalData = additionalData|merge([form_row(child)]) %}
        {% endif %}
    {% endfor %}

    {% if additionalData is not empty %}
        {% set dataBlocks = dataBlocks|merge([{
        'title': 'marello.order.sections.additional'|trans,
        'subblocks': [{
            'title': '',
            'useSpan': false,
            'data' : additionalData
        }]
        }]) %}
    {% endif %}

    {% set data = {
        'formErrors': form_errors(form)? form_errors(form) : null,
        'dataBlocks': dataBlocks,
    } %}
    {{ parent() }}
{% endblock content_data %}
