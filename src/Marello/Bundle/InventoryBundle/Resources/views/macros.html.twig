{#
    Renders chart

    parameters:
        name: chart name
        options: options for chart
        config: config for chart
        isMobileVersion: render for mobile
#}
{% macro renderChart(data, options, config, isMobileVersion) %}
    {% set name = options.name|replace({'_chart': ''}) %}
    {% set params = {
    ratio: isMobileVersion ? '0.8' : '0.35',
    data: data,
    options: options,
    config: config,
    date: (options.settings.quarterDate is defined) ? options.settings.quarterDate|oro_format_date({timeZone: oro_timezone()}) : ''
    } %}


    <div data-page-component-module="marelloinventory/js/app/components/{{ name }}-chart-component"
         data-page-component-options="{{ params|json_encode }}"></div>
{% endmacro %}

{#
Render Order view link based on OrderItem

parameters:
    orderItemId: order item id
#}
{% macro renderOrderViewLink(orderItemId) %}
    {% import '@OroUI/macros.html.twig' as UI %}
    {% set label = orderItemId %}
    {% if is_granted('marello_order_view') %}
        {% set order = marello_get_order_by_item_id(orderItemId) %}
        {% if order is not null %}
            {% set result = UI.renderUrl(path('marello_order_order_view', {'id': order.id}), order.orderNumber) %}
        {% else %}
            {% set result = label|escape %}
        {% endif %}
    {% else %}
        {% set result = label|escape %}
    {% endif %}
    {{ result }}
{% endmacro %}
