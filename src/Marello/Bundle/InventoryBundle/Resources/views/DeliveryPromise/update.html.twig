{% extends '@OroUI/actions/update.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}

{% form_theme form with '@OroForm/Form/fields.html.twig' %}

{% set formAction = entity.id ? path('marello_inventory_deliverypromise_update', { id: entity.id }) : path('marello_inventory_deliverypromise_create') %}

{% block navButtons %}
    {{ parent() }}
    {{ UI.cancelButton(path('marello_inventory_deliverypromise_index')) }}
    {% if entity.id and is_granted('marello_inventory_deliverypromise_update') or is_granted('marello_inventory_deliverypromise_create') %}
        {% set html = '' %}
        {% if is_granted('marello_inventory_deliverypromise_view') %}
            {% set html = UI.saveAndCloseButton({
                'route': 'marello_inventory_deliverypromise_view',
                'params': {'id': '$id'}
            }) %}
        {% endif %}
        {% set html = html ~ UI.saveAndStayButton({
            'route': 'marello_inventory_deliverypromise_update',
            'params': {'id': '$id'}
        }) %}

        {{ UI.dropdownSaveButton({'html': html}) }}
    {% endif %}
{% endblock navButtons %}

{% block pageHeader %}
    {% set title = 'marello.inventory.deliverypromise.entity_label'|trans %}
    {% include '@OroUI/page_title_block.html.twig' with { title: title } %}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'marello-deliverypromise-update' %}

    {% set generalData = [
        form_row(form.code),
        form_row(form.labels),
        form_row(form.minDays),
        form_row(form.maxDays),
        form_row(form.tooltips)
    ] %}

    {% set dataBlocks = [
        {
            'title': 'marello.product.sections.general'|trans,
            'subblocks': [{
                'title': 'General',
                'data': generalData
            }]
        }
    ] %}

    {% set data = {
        'formErrors': form_errors(form)? form_errors(form) : null,
        'dataBlocks': dataBlocks,
    } %}
    {{ parent() }}
{% endblock content_data %}
