{% extends '@OroUI/actions/update.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}
{% import '@OroDataGrid/macros.html.twig' as dataGrid %}
{% set gridName = 'marello-product-variant-extended-grid' %}

{% set entity = form.vars.value %}
{% set formAction = entity.id ? path('marello_product_add_variant', { parentId: parent.id, id: entity.id }) : path('marello_product_create_variant', { id: parent.id }) %}

{% if parent.id %}
    {% oro_title_set({params : {"%product.name%": parent.name } }) %}
{% endif %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entity':      parent,
        'indexPath':   path('marello_product_view', { id: parent.id}),
        'indexLabel':  'marello.product.variant.entity_plural_label'|trans,
        'entityTitle': parent.name|default('N/A')
    } %}
    {{ parent() }}
{% endblock pageHeader %}

{% block navButtons %}
    {{ UI.cancelButton(path('marello_product_view', { id: parent.id })) }}

    {% set html = UI.saveAndCloseButton({
        'route': 'marello_product_view',
        'params': {
            'id': parent.id,
            '_enableContentProviders': 'mainMenu'
        }
    }) %}
    {{ UI.dropdownSaveButton({'html': html}) }}
{% endblock %}


{% block content_data %}
    {% set id = 'marello-product-variant-update' %}

    {% set productsVariantSelector %}
        <div data-page-component-module="marelloproduct/js/app/components/product-variant-component">
            {{ form_row(form.variantFields) }}
        </div>
    {% endset %}

    {% set dataBlocks = [
        {
            'title': 'marello.product.sections.general'|trans,
            'class': 'active',
            'subblocks': [{
            'data': [
                    form_row(form.names),
                    form_row(form.variantCode),
                    form_row(form.image),
                    form_row(form.ARFile),
                    form_row(form.descriptions),
                    productsVariantSelector
                ]
            }]
        },
        {
            'title': 'marello.product.variant.entity_plural_label'|trans,
            'subblocks': [{
                'title': '',
                'useSpan': false,
                'data' : [
                    form_widget(form.addVariants, {'id': 'addVariants'}),
                    form_widget(form.removeVariants, {'id': 'removeVariants'}),
                    dataGrid.renderGrid(gridName, { product: parent.id ? : null, variant: parent.variant.id ? : null, attributeFamily: parent.attributeFamily.id ? : null })
                ]
            }]
        }
    ] %}

    {% set additionalData = [] %}
    {% for child in form.children %}
        {% if child.vars.extra_field is defined and child.vars.extra_field %}
            {% set additionalData = additionalData|merge([form_row(child)]) %}
        {% endif %}
    {% endfor %}

    {% if additionalData is not empty %}
        {% set dataBlocks = dataBlocks|merge([{
            'title': 'marello.product.sections.additional'|trans,
            'subblocks': [{
                'title': '',
                'useSpan': false,
                'data' : additionalData
            }]
        }] ) %}
    {% endif %}

    {% set data = {
        'formErrors': form_errors(form)? form_errors(form) : null,
        'dataBlocks': dataBlocks,
    } %}
    
    {{ parent() }}
{% endblock %}
