{% extends '@OroUI/actions/update.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}
{% import '@OroDataGrid/macros.html.twig' as dataGrid %}

{% oro_title_set({params : {"%name%": entity.name, '%entityName%': 'marello.digitalasset.category.entity_label'|trans} }) %}

{% set formAction = entity.id ? path('marello_digital_asset_category_update', {id: entity.id}) : path('marello_digital_asset_category_create') %}

{% block navButtons %}
    {{ parent() }}

    {{ UI.cancelButton(path('marello_digital_asset_category_index')) }}
    {% if is_granted('marello_digital_asset_category_update') %}
        {% set html = '' %}
        {% if is_granted('marello_digital_asset_category_view') %}
            {% set html = UI.saveAndCloseButton({
                'route': 'marello_digital_asset_category_view',
                'params': {'id': '$id'}
            }) %}
        {% endif %}
        {% set html = html ~ UI.saveAndStayButton({
            'route': 'marello_digital_asset_category_update',
            'params': {'id': '$id'}
        }) %}

        {{ UI.dropdownSaveButton({'html': html}) }}
    {% endif %}
{% endblock navButtons %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entity':      entity,
        'indexPath':   path('marello_digital_asset_category_index'),
        'indexLabel':  'marello.digitalasset.category.entity_plural_label'|trans,
        'entityTitle': entity.name|default('N/A'|trans)
    } %}
    {{ parent() }}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'marello-digital-asset-category-update' %}

    {% set dataBlocks = [
        {
            'title': 'marello.sections.general'|trans,
            'subblocks': [{
            'title': '',
            'data': [
                form_row(form.name)
            ]
        }]
        }
    ] %}

    {% set data = {
        'formErrors': form_errors(form),
        'dataBlocks': dataBlocks
    }%}

    <div class="responsive-form-inner">
        {{ parent() }}
    </div>
{% endblock content_data %}