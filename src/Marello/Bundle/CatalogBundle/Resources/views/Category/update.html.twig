{% extends '@OroUI/actions/update.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}
{% import '@OroDataGrid/macros.html.twig' as dataGrid %}
{% form_theme form with '@OroForm/Form/fields.html.twig' %}
{% if form.vars.value.id %}
    {% set formAction = path('marello_category_update', { 'id': form.vars.value.id }) %}
    {% oro_title_set({params : {"%name%": entity.name }}) %}
{% else %}
    {% set formAction = path('marello_category_create') %}
{% endif %}

{% block navButtons %}
    {{ parent() }}

    {{ UI.cancelButton(path('marello_category_index')) }}
    {% if is_granted('marello_category_update') %}
        {% set html = '' %}
        {% if is_granted('marello_category_view') %}
            {% set html = UI.saveAndCloseButton({
            'route': 'marello_category_view',
            'params': {'id': '$id'}
            }) %}
        {% endif %}
        {% set html = html ~ UI.saveAndStayButton({
        'route': 'marello_category_update',
        'params': {'id': '$id'}
        }) %}

        {{ UI.dropdownSaveButton({'html': html}) }}
    {% endif %}
{% endblock navButtons %}

{% block pageHeader %}
    {% if form.vars.value.id %}
        {% set breadcrumbs = {
        'entity':      form.vars.value,
        'indexPath':   path('marello_category_index'),
        'indexLabel': 'marello.catalog.category.entity_plural_label'|trans,
        'entityTitle': entity.name|default('N/A')
        } %}
        {{ parent() }}
    {% else %}
        {% set title = 'oro.ui.create_entity'|trans({'%entityName%': 'marello.catalog.category.entity_label'|trans}) %}
        {% include '@OroUI/page_title_block.html.twig' with { title: title } %}
    {% endif %}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'marello-category-update' %}

    {% set companiesIds = marello_category_get_companies_ids(entity)|length > 0 ? marello_category_get_companies_ids(entity) : 0 %}

    {% set dataBlocks = [{
            'title': 'General'|trans,
            'class': 'active',
            'subblocks': [{
            'title': '',
            'data': [
                form_row(form.name),
                form_row(form.code),
                form_row(form.type),
                form_row(form.description),
                form_widget(form.appendCompanies, {'id': 'appendCompanies'}),
                form_widget(form.removeCompanies, {'id': 'removeCompanies'}),
                form_widget(form.appendProducts, {'id': 'appendProducts'}),
                form_widget(form.removeProducts, {'id': 'removeProducts'}),
            ]
        }]}
    ] %}

    {% if is_granted('marello_category_update') and form.vars.value.id and entity.type == 'customer' %}
        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.catalog.category.permissions.label'|trans,
            'subblocks': [
                {
                    'title' : null,
                    'useSpan': false,
                    'data' : [
                        form_row(form.customer),
                        form_row(form.company),
                    ]
                }
            ]
        }]) %}
    {% endif %}

    {% if is_granted('marello_category_update') %}
        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.product.entity_plural_label'|trans,
            'subblocks': [
                {
                    'title' : null,
                    'useSpan': false,
                    'data' : [dataGrid.renderGrid('marello-category-products-extend-grid', { category_id: entity.id ? entity.id : 0,}, { cssClass: 'inner-grid' })]
                }
            ]
        }]) %}
    {% endif %}

    {% if (is_granted('marello_category_update') and entity.type == 'default') or form.vars.value.id == null %}
        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.customer.company.entity_plural_label'|trans,
            'subblocks': [
                {
                    'title' : null,
                    'useSpan': false,
                    'data' : [
                        dataGrid.renderGrid('marello-category-companies-extend-grid', { category_id: entity.id ? entity.id : null, companies: companiesIds }, { cssClass: 'inner-grid' })
                    ]
                }
            ]
        }]) %}
    {% endif %}

    {% set additionalData = [] %}
    {% for child in form.children %}
        {% if child.vars.extra_field is defined and child.vars.extra_field %}
            {% set additionalData = additionalData|merge([form_row(child)]) %}

            {{ entity.id }}
            {{ companiesIds }}
        {% endif %}
    {% endfor %}

    {% if additionalData is not empty %}
        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.catalog.category.sections.additional'|trans,
            'subblocks': [{
                'title' : null,
                'useSpan': false,
                'data' : [
                    additionalData
                ]
            }]
        }]) %}
    {% endif %}

    {% set data = {
        'formErrors': form_errors(form)? form_errors(form) : null,
        'dataBlocks': dataBlocks,
    } %}
    {{ parent() }}
{% endblock content_data %}
