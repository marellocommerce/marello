{% extends '@OroUI/actions/view.html.twig' %}
{% import '@OroDataGrid/macros.html.twig' as dataGrid %}
{% import '@OroUI/macros.html.twig' as UI %}
{% import '@OroEntityConfig/macros.html.twig' as entityConfig %}

{% oro_title_set({params : {"%name%": entity.defaultName.string|default('N/A'|trans) } }) %}
{% set gridName  = 'marello-categories-grid' %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entity':      entity,
        'indexPath':   path('marello_category_index'),
        'indexLabel':  'marello.catalog.category.entity_plural_label'|trans,
        'entityTitle': entity.defaultName.string|default('N/A'|trans)
    } %}

    {{ parent() }}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'marello-category-view' %}
    {% set generalSubblocks = [] %}
    {% set generalInformation %}
        <div class="widget-content">
            <div class="row-fluid form-horizontal">
                <div class="responsive-block">
                    <div class="box-type1">
                        {{ UI.renderProperty('marello.catalog.category.names.label'|trans, entity.defaultName.string) }}
                        {{ UI.renderProperty('marello.catalog.category.code.label'|trans, entity.code) }}
                        {{ UI.renderProperty('marello.catalog.category.type.label'|trans, entity.type) }}
                        {{ UI.renderProperty('marello.catalog.category.descriptions.label'|trans, entity.defaultDescription.text) }}
                    </div>
                </div>
            </div>
        </div>
    {% endset %}

    {% set generalSubblocks = generalSubblocks|merge([{'data' : [generalInformation] }]) %}
    {% set dataBlocks = [{
        'title': 'General'|trans,
        'subblocks': generalSubblocks
    }] %}

    {% if entity.type == 'customer' %}
        {% set permissionInformation %}
            <div class="widget-content">
                <div class="row-fluid form-horizontal">
                    <div class="responsive-block">
                        <div class="box-type1">
                            {{ UI.renderProperty('marello.customer.entity_label'|trans, entity.customer) }}
                            {{ UI.renderProperty('marello.catalog.category.is_personal.label'|trans, entity.isPersonal ?
                                'marello.core.yes.label'|trans : 'marello.core.no.label'|trans) }}
                            {% if entity.isPersonal == false %}
                                {{ UI.renderProperty('marello.customer.company.entity_label'|trans, entity.customer.company) }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endset %}

        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.catalog.category.permissions.label'|trans,
            'subblocks': [{
                'title' : null,
                'useSpan': false,
                'data' : [
                    permissionInformation
                ]
            }]
        }]) %}
    {% endif %}

    {% set categoryProductsWidget %}
        {{ dataGrid.renderGrid('marello-category-products-grid', {'products': entity.products}) }}
    {% endset %}

    {% set dataBlocks = dataBlocks|merge([{
        'title' : 'marello.product.entity_plural_label'|trans,
        'subblocks': [{
            'title' : null,
            'useSpan': false,
            'data' : [
                categoryProductsWidget
            ]
        }]
    }]) %}

    {% if entity.type == 'default' %}
        {% set categoryCompaniesWidget %}
            {{ dataGrid.renderGrid('marello-category-companies-grid', {'companies': entity.companies}) }}
        {% endset %}

        {% set dataBlocks = dataBlocks|merge([{
            'title' : 'marello.customer.company.entity_plural_label'|trans,
            'subblocks': [{
                'title' : null,
                'useSpan': false,
                'data' : [
                    categoryCompaniesWidget
                ]
            }]
        }]) %}
    {% endif %}

    {% set additionalData %}
        <div class="widget-content">
            <div class="row-fluid form-horizontal">
                <div class="responsive-block">
                    {{ entityConfig.renderDynamicFields(entity) }}
                </div>
            </div>
        </div>
    {% endset %}

    {% set dataBlocks = dataBlocks|merge([{
        'title' : 'marello.catalog.category.sections.additional'|trans,
        'subblocks': [{
            'title' : null,
            'useSpan': false,
            'data' : [
                additionalData
            ]
        }]
    }]) %}

    {% set data = { 'dataBlocks': dataBlocks } %}
    {{ parent() }}
{% endblock content_data %}
