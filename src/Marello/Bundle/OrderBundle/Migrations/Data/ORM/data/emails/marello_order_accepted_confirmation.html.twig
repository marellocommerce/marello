{# @name = marello_order_accepted_confirmation #}
{# @entityName = Marello\Bundle\OrderBundle\Entity\Order #}
{# @subject = Thank you for your order #{{ entity.orderNumber }} #}
{# @type = html #}
{# @isSystem = 0 #}
{# @isEditable = 1 #}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Confirmation</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8;">
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:20px 0;">
    <tr>
        <td align="center">
            <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-collapse:collapse; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
                <tr>
                    <td style="padding:24px 24px; background-color:#1d293d;">
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td align="left">
                                    <a href="" target="_blank" style="text-decoration:none;">
                                        <img
                                                src="{{ system.appURL ~ '/bundles/marellocore/img/marello-logo.png' }}"
                                                alt=""
                                                width="128"
                                                height="53"
                                                style="
                          display:block;
                          border:0;
                          outline:none;
                          text-decoration:none;
                          max-width:160px;
                          height:auto;
                        ">
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 24px; border-bottom:1px solid #e5e7eb;">
                        <h1 style="margin:0; font-size:22px; font-weight:bold;">
                            Thank you for your order
                        </h1>
                        <p style="margin:8px 0 16px; font-size:14px;">
                            <strong>Order: {{ entity.orderNumber }}</strong>
                        </p>
                        <p style="margin:0; font-size:12px; line-height:20px;">
                            Purchase date: {{ entity.purchaseDate|date('d-m-Y H:i:s') }}
                        </p>
                        <p style="margin:0; font-size:12px; line-height:20px;">
                            PO number: {{ entity.poNumber is not empty ? entity.poNumber : 'N/A' }}
                        </p>
                        <p style="margin:0; font-size:12px; line-height:20px;">
                            VAT ID: {{ entity.customer.company is not empty ? entity.customer.company.taxIdentificationNumber : 'N/A' }}
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 24px;">
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td width="50%" valign="top" style="padding-right:16px;">
                                    <h3 style="margin:0 0 8px; font-size:14px; text-transform:uppercase; color:#6b7280;">
                                        Bill To
                                    </h3>
                                    <p style="margin:0; font-size:12px; line-height:20px;">
                                        {{ entity.billingAddress.company }}<br>
                                        {{ entity.billingAddress | oro_format_address | escape | nl2br }}
                                    </p>
                                </td>
                                <td width="50%" valign="top" style="padding-left:16px;">
                                    <h3 style="margin:0 0 8px; font-size:14px; text-transform:uppercase; color:#6b7280;">
                                        Ship To
                                    </h3>
                                    <p style="margin:0; font-size:12px; line-height:20px;">
                                        {{ entity.shippingAddress.company }}<br>
                                        {{ entity.shippingAddress | oro_format_address | escape | nl2br }}
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 24px;">
                        <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                            <tr>
                                <th align="left" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb;">SKU</th>
                                <th width=“200” align="left" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb; white-space:nowrap;">Product</th>
                                <th align="center" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb;">Qty</th>
                                <th align="right" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb;">Unit</th>
                                <th align="right" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb;">Price</th>
                                <th align="right" style="padding:8px; font-size:12px; border-bottom:1px solid #e5e7eb;">Total</th>
                            </tr>

                            <!--{% for item in entity.items %}-->
                            <tr>
                                <td align="left" style="padding:8px; font-size:12px; color:#6b7280;">{{ item.productSku }}</td>
                                <td width=“200” align="left" style="padding:8px; font-size:12px;">{{ item.productName }}</td>
                                <td align="center" style="padding:8px; font-size:12px;">{{ item.quantity }}</td>
                                <td align="right" style="padding:8px; font-size:12px;">{{ item.productUnit.name }}</td>
                                <td align="right" style="padding:8px; font-size:12px;">{{ item.price|oro_format_currency({'currency': entity.currency}) }}</td>
                                <td align="right" style="padding:8px; font-size:12px; font-weight:bold;">
                                    {{ item.rowTotalExclTax|oro_format_currency({'currency': entity.currency}) }}
                                </td>
                            </tr>
                            <!--{% endfor %}-->

                        </table>
                    </td>
                </tr>

                <!-- Totals -->
                <tr>
                    <td style="padding:24px 24px;">
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td width="60%"></td>
                                <td width="40%">
                                    <table width="100%" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td style="padding:8px; font-size:12px;">Subtotal (excl. tax)</td>
                                            <td align="right" style="padding:8px; font-size:12px;">
                                                {{ entity.subtotal|oro_format_currency({'currency': entity.currency}) }}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:8px; font-size:12px;">Total tax</td>
                                            <td align="right" style="padding:8px; font-size:12px;">
                                                {{ entity.totalTax|oro_format_currency({'currency': entity.currency}) }}
                                            </td>
                                        </tr>
                                        <!--{% if entity.discountAmount %}-->
                                        <tr>
                                            <td style="padding:8px; font-size:12px;">Discount</td>
                                            <td align="right" style="padding:8px; font-size:12px;">
                                                {{ entity.discountAmount|oro_format_currency({'currency': entity.currency}) }}
                                            </td>
                                        </tr>
                                        <!--{% endif %}-->
                                        <tr>
                                            <td style="padding:8px; font-size:12px;">Shipping</td>
                                            <td align="right" style="padding:8px; font-size:12px;">
                                                {{ entity.shippingAmountInclTax|oro_format_currency({'currency': entity.currency}) }}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:8px; font-size:14px; font-weight:bold; border-top:1px solid #e5e7eb;">
                                                Grand Total
                                            </td>
                                            <td align="right" style="padding:8px; font-size:14px; font-weight:bold; border-top:1px solid #e5e7eb;">
                                                {{ entity.grandTotal|oro_format_currency({'currency': entity.currency}) }}
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 24px; border-top:1px solid #e5e7eb; font-size:12px; color:#6b7280;">
                        <p style="margin:8px 0 0;">
                            © {{ entity.salesChannelName }}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>